# Sanity CMS connection.
#
# Leave these empty and the website runs on the content in src/data/ — which is how it
# works today. Fill them in and every page switches to reading from the CMS instead.
#
# Get the project ID from sanity.io/manage after creating the project (see cms/README.md).
# Copy this file to .env.local and fill it in. Never commit .env.local.

VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Admin dashboard
# Password the foundation uses to sign in at /admin. Set a real one before deploying.
ADMIN_PASSWORD=

# Optional: separate secret for signing session cookies. Falls back to ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# Sanity token with write access, from sanity.io/manage > API > Tokens (Editor role).
# Only needed in production — locally the token from `npx sanity login` is used.
SANITY_WRITE_TOKEN=
