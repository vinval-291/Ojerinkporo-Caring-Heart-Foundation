# Dependencies
node_modules/

# Build output
dist/
.vercel/
.sanity/

# Environment — never commit these. .env.local carries ADMIN_PASSWORD and
# would let anyone who reads the repo sign into the dashboard.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
*.swp

# Original archive — superseded by source/
*.zip

# Local logs
*.log
npm-debug.log*

# Local CMS backups — may contain draft and test content
cms/backups/

# Editor workspace settings
.vscode/

# Source photographs and briefs dropped in the project root to be processed.
# The versions the site actually serves live in source/public/images, resized and
# re-encoded — the originals here run to about 70 MB and have no business in a repo
# that gets cloned. Keep them, just not in git.
/2026_outreach/
/*.jpeg
/*.jpg
/*.JPG
/*.png
/*.PNG
/*.webp
/*.pdf

# The original site audit. Deliberately not published: it names two different people
# as founder, which was the point of the audit and is not a public document.
export/

# Built output of the dashboard server — produced by `npm run build:api`.
preview-deploy/ochf-admin-api/

# Scratch scripts
/*.mjs
